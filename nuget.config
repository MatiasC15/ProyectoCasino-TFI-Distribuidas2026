<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Limpiamos las fuentes globales y forzamos a usar el NuGet oficial -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Apagamos la regla restrictiva que te está causando el error -->
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
</configuration>